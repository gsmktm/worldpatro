# Primary persistence provider
NEXT_PUBLIC_DATABASE_PROVIDER=firebase

# Firebase Web app config (Project settings > Your apps > Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin credentials.
# Recommended on Vercel: one encrypted JSON string copied from a service-account key.
# Never prefix this with NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional split-form server credentials if JSON is not used.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional legacy/secondary Supabase backend. World Patro does not require this
# when Firebase is configured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Product
NEXT_PUBLIC_SITE_URL=http://localhost:3000
WORLD_PATRO_DEFAULT_LAT=27.7172
WORLD_PATRO_DEFAULT_LON=85.3240
WORLD_PATRO_DEFAULT_TZ=Asia/Kathmandu
