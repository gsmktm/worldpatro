# Data backend: "firebase" is preferred when configured; "supabase" remains supported.
WORLD_PATRO_DATA_BACKEND=firebase

# Vercel AI Gateway
# Vercel deployments can authenticate with OIDC; local/non-Vercel environments may use AI_GATEWAY_API_KEY.
AI_GATEWAY_MODEL_SUPERVISOR=openai/gpt-5.6-sol
AI_GATEWAY_MODEL_SUBAGENT=openai/gpt-5.6-luna
AI_GATEWAY_API_KEY=

# Agent access: authenticated (production default), public, or api-key.
WORLD_PATRO_AGENT_ACCESS_MODE=authenticated
# Only needed when WORLD_PATRO_AGENT_ACCESS_MODE=api-key. Keep server-only.
WORLD_PATRO_AGENT_API_KEY=

# Firebase Web configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin — server-only. Base64 encode the full service-account JSON file.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
FIREBASE_SESSION_COOKIE_NAME=worldpatro_session

# Supabase fallback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Public/API integrations
# No-key active integrations: World Bank, USGS Earthquake, Frankfurter, Nager.Date (global fallback only).
# NASA: optional server-only key. Do not expose in NEXT_PUBLIC_*.
NASA_API_KEY=
# REST Countries v5 currently requires a server-side API key.
REST_COUNTRIES_API_KEY=
# Hosted production geocoder.
OPENCAGE_API_KEY=
# Open-Meteo commercial customer endpoint key. Free hosted API is non-commercial.
OPEN_METEO_API_KEY=
# Explicit opt-ins. Leave false in production unless policy/licensing has been reviewed.
WORLD_PATRO_ALLOW_PUBLIC_NOMINATIM=false
WORLD_PATRO_ALLOW_NONCOMMERCIAL_APIS=false

# Product
NEXT_PUBLIC_SITE_URL=http://localhost:3000
WORLD_PATRO_DEFAULT_LAT=27.7172
WORLD_PATRO_DEFAULT_LON=85.3240
WORLD_PATRO_DEFAULT_TZ=Asia/Kathmandu
