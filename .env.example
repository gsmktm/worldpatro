# Data backend: "firebase" is preferred when configured; "supabase" remains supported.
WORLD_PATRO_DATA_BACKEND=firebase

# Firebase Web configuration (public, used by browser Firebase Auth)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (server-only). Base64 encode the full service-account JSON file.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
FIREBASE_SESSION_COOKIE_NAME=worldpatro_session

# Supabase fallback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Product
NEXT_PUBLIC_SITE_URL=http://localhost:3000
WORLD_PATRO_DEFAULT_LAT=27.7172
WORLD_PATRO_DEFAULT_LON=85.3240
WORLD_PATRO_DEFAULT_TZ=Asia/Kathmandu
