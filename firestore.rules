rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // World Patro currently routes privileged reads/writes through Next.js server APIs
    // using Firebase Admin. Admin SDK requests bypass Firestore Security Rules.
    // Direct browser access is denied by default until a reviewed client rule is added.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
